{
  "name": "clean-chat-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Clean Chat 모듈별 E2E 시뮬레이션 웹앱 (사내 테스트 도구, Mock 데이터 전용)",
  "scripts": {
    "predev": "npm run sync-shared",
    "dev": "next dev -p 3100",
    "prebuild": "npm run sync-shared",
    "build": "next build",
    "start": "next start -p 3100",
    "pretypecheck": "npm run sync-shared",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run sync-shared",
    "test": "jest",
    "verify": "npm run typecheck && npm test && npm run build",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "json-schema-to-typescript": "15.0.4",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
