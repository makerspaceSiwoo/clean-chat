# 복사해서 .env.local 로 쓰세요 (git 제외).
# NEXT_PUBLIC_* 값은 빌드할 때 화면 코드에 들어갑니다 → 비밀값(API 키 등)을 넣지 마세요.

# 어느 서버인지 표시: local | develop | main
NEXT_PUBLIC_APP_ENV=local

# 로컬 모듈 실행 서버 주소 (uv run clean-chat serve). 실제 파이썬 모듈 함수를 부른다 — Mock 없음
NEXT_PUBLIC_API_BASE_URL=http://localhost:8765

# 요청 제한 시간(ms). 모델 로딩이 오래 걸리면 늘리세요
NEXT_PUBLIC_API_TIMEOUT_MS=30000
