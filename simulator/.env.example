# 복사해서 .env.local 로 쓰세요 (git 제외). 서버마다 다른 값을 넣습니다.
# NEXT_PUBLIC_* 값은 빌드할 때 화면 코드에 들어갑니다 → 비밀값(API 키 등)을 넣지 마세요.

# 어느 서버인지 표시: local | develop | main
NEXT_PUBLIC_APP_ENV=local

# 데이터 소스: mock(레포 fixtures 응답, 백엔드 불필요) | http(실제 Stage 실행 API 호출)
NEXT_PUBLIC_API_MODE=mock

# API_MODE=http 일 때 호출할 주소 (예: develop 서버 http://sim-api-develop:8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 요청 제한 시간(ms). 넘으면 타임아웃 오류로 표시
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# mock 모드에서 흉내 낼 응답 지연(ms). 로딩 화면 확인용
NEXT_PUBLIC_MOCK_LATENCY_MS=500
