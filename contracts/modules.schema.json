{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clean Chat module contracts",
  "description": "자동 생성 파일 — 직접 고치지 말고 scripts/export_contracts.py 로 다시 만드세요.",
  "schema_version": "1.0.0",
  "modules": {
    "ocr": {
      "title": "OCR · 이미지 → 텍스트 줄",
      "path": "src/clean_chat/modules/ocr/impl.py",
      "input": {
        "$ref": "#/$defs/Frame"
      },
      "output": {
        "$ref": "#/$defs/OcrResult"
      }
    },
    "parse": {
      "title": "채팅 추출 · 시스템 메시지 제외 + 정규화",
      "path": "src/clean_chat/modules/parse/impl.py",
      "input": {
        "$ref": "#/$defs/ParseRequest"
      },
      "output": {
        "$ref": "#/$defs/ParseResult"
      }
    },
    "analyze": {
      "title": "분석 · 대상·등급·피드백",
      "path": "src/clean_chat/modules/analyze/impl.py",
      "input": {
        "$ref": "#/$defs/AnalyzeRequest"
      },
      "output": {
        "$ref": "#/$defs/Analysis"
      }
    },
    "rewrite": {
      "title": "순화 · 피드백만 공손하게",
      "path": "src/clean_chat/modules/rewrite/impl.py",
      "input": {
        "$ref": "#/$defs/RewriteRequest"
      },
      "output": {
        "$ref": "#/$defs/Rewrite"
      }
    },
    "report": {
      "title": "신고 문구 · 고소장 초안",
      "path": "src/clean_chat/modules/report/impl.py",
      "input": {
        "$ref": "#/$defs/ReportRequest"
      },
      "output": {
        "$ref": "#/$defs/ReportDraft"
      }
    }
  },
  "$defs": {
    "Action": {
      "enum": [
        "show",
        "show_masked",
        "show_rewritten",
        "hide",
        "copy",
        "copy_masked",
        "copy_rewritten",
        "block"
      ],
      "title": "Action",
      "type": "string"
    },
    "Analysis": {
      "description": "판단만 한다(얼마나 나쁜가, 누구를 향하나). 숨김·신고·차단 같은 처리는 구성(core/policy.py)이 정한다.",
      "properties": {
        "msg_id": {
          "title": "Msg Id",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "harm_types": {
          "items": {
            "$ref": "#/$defs/HarmType"
          },
          "title": "Harm Types",
          "type": "array"
        },
        "profanity_spans": {
          "items": {
            "type": "string"
          },
          "title": "Profanity Spans",
          "type": "array"
        },
        "feedback_spans": {
          "items": {
            "type": "string"
          },
          "title": "Feedback Spans",
          "type": "array"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        }
      },
      "required": [
        "msg_id",
        "level",
        "model_version"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "AnalyzeRequest": {
      "properties": {
        "message": {
          "$ref": "#/$defs/ChatMessage"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "title": "History",
          "type": "array"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/Player"
          },
          "title": "Players",
          "type": "array"
        }
      },
      "required": [
        "message"
      ],
      "title": "AnalyzeRequest",
      "type": "object"
    },
    "Channel": {
      "description": "채팅 채널. 시스템 메시지·핑은 채팅이 아니라서 parse 가 걸러낸다(message=None).",
      "enum": [
        "team",
        "all",
        "unknown"
      ],
      "title": "Channel",
      "type": "string"
    },
    "ChatMessage": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "speaker": {
          "title": "Speaker",
          "type": "string"
        },
        "champion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Champion"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_norm": {
          "title": "Text Norm",
          "type": "string"
        },
        "hints": {
          "items": {
            "type": "string"
          },
          "title": "Hints",
          "type": "array"
        },
        "is_me": {
          "default": false,
          "title": "Is Me",
          "type": "boolean"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts",
        "source",
        "channel",
        "speaker",
        "text",
        "text_norm",
        "raw"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "Decision": {
      "properties": {
        "msg_id": {
          "title": "Msg Id",
          "type": "string"
        },
        "is_me": {
          "title": "Is Me",
          "type": "boolean"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "display_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Text"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "report": {
          "default": false,
          "title": "Report",
          "type": "boolean"
        },
        "complaint_candidate": {
          "default": false,
          "title": "Complaint Candidate",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "msg_id",
        "is_me",
        "action",
        "display_text"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Frame": {
      "description": "캡처한 채팅창 이미지 1장. Mac에서는 저장된 스크린샷 파일로 대체해서 테스트.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        },
        "image_path": {
          "title": "Image Path",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/Region"
        }
      },
      "required": [
        "id",
        "ts",
        "image_path",
        "region"
      ],
      "title": "Frame",
      "type": "object"
    },
    "GameSession": {
      "description": "게임 1판의 기록. IN_GAME 동안 쌓고, POST_GAME 에서 report/complaint 의 입력이 된다.\n\n로컬 저장만 허용: .clean-chat/sessions/<id>.jsonl (git 제외).\nincidents 에는 다른 유저 채팅(흐름 A)만 들어간다. 내 채팅(흐름 B)은 복사/차단으로 끝나고 기록하지 않는다.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "number"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/Player"
          },
          "title": "Players",
          "type": "array"
        },
        "incidents": {
          "items": {
            "$ref": "#/$defs/Incident"
          },
          "title": "Incidents",
          "type": "array"
        }
      },
      "required": [
        "id",
        "started_at"
      ],
      "title": "GameSession",
      "type": "object"
    },
    "HarmType": {
      "enum": [
        "profanity",
        "family_insult",
        "sexual_harassment",
        "blame",
        "instigation"
      ],
      "title": "HarmType",
      "type": "string"
    },
    "Incident": {
      "description": "클라이언트 '처리 내역'에 보이는 기록 한 건. 로컬 저장만 허용.",
      "properties": {
        "msg": {
          "$ref": "#/$defs/ChatMessage"
        },
        "analysis": {
          "$ref": "#/$defs/Analysis"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "rewrite": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rewrite"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "msg",
        "analysis",
        "decision"
      ],
      "title": "Incident",
      "type": "object"
    },
    "Level": {
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "Level",
      "type": "integer"
    },
    "OcrResult": {
      "description": "Frame 1장에서 읽은 줄 전부(위에서 아래 순서). 앞 프레임과 겹치는 줄 제거는 구성(core)이 한다.",
      "properties": {
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/RawLine"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "frame_id",
        "lines"
      ],
      "title": "OcrResult",
      "type": "object"
    },
    "ParseRequest": {
      "properties": {
        "line": {
          "$ref": "#/$defs/RawLine"
        },
        "my_name": {
          "title": "My Name",
          "type": "string"
        }
      },
      "required": [
        "line",
        "my_name"
      ],
      "title": "ParseRequest",
      "type": "object"
    },
    "ParseResult": {
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatMessage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "line_id",
        "message"
      ],
      "title": "ParseResult",
      "type": "object"
    },
    "Player": {
      "description": "게임 참가자. 로컬 Live Client Data API(127.0.0.1:2999) 또는 설정값에서 얻음.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "champion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Champion"
        },
        "team": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "is_me": {
          "default": false,
          "title": "Is Me",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "Player",
      "type": "object"
    },
    "RawLine": {
      "description": "채팅창에 보이는 한 줄(가공 전). OCR 결과이거나, 흐름 B 에서는 내가 입력한 문장.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "ocr_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Confidence"
        }
      },
      "required": [
        "id",
        "ts",
        "text",
        "source"
      ],
      "title": "RawLine",
      "type": "object"
    },
    "Region": {
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "title": "W",
          "type": "integer"
        },
        "h": {
          "title": "H",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Region",
      "type": "object"
    },
    "ReportDraft": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReportKind"
        },
        "speaker": {
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "incident_ids": {
          "items": {
            "type": "string"
          },
          "title": "Incident Ids",
          "type": "array"
        },
        "pdf_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Path"
        }
      },
      "required": [
        "kind",
        "speaker",
        "text",
        "incident_ids"
      ],
      "title": "ReportDraft",
      "type": "object"
    },
    "ReportKind": {
      "enum": [
        "report",
        "complaint"
      ],
      "title": "ReportKind",
      "type": "string"
    },
    "ReportRequest": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReportKind"
        },
        "session": {
          "$ref": "#/$defs/GameSession"
        },
        "speaker": {
          "title": "Speaker",
          "type": "string"
        },
        "complainant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Complainant"
        },
        "output_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Dir"
        }
      },
      "required": [
        "kind",
        "session",
        "speaker"
      ],
      "title": "ReportRequest",
      "type": "object"
    },
    "Rewrite": {
      "properties": {
        "msg_id": {
          "title": "Msg Id",
          "type": "string"
        },
        "rewritten": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rewritten"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        }
      },
      "required": [
        "msg_id",
        "rewritten",
        "backend"
      ],
      "title": "Rewrite",
      "type": "object"
    },
    "RewriteRequest": {
      "properties": {
        "message": {
          "$ref": "#/$defs/ChatMessage"
        },
        "analysis": {
          "$ref": "#/$defs/Analysis"
        }
      },
      "required": [
        "message",
        "analysis"
      ],
      "title": "RewriteRequest",
      "type": "object"
    },
    "Source": {
      "enum": [
        "ocr",
        "demo",
        "self_input"
      ],
      "title": "Source",
      "type": "string"
    }
  }
}
